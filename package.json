{
  "name": "luminary",
  "version": "1.2.0",
  "private": true,
  "description": "Luminary monorepo: desktop (Electron) + android (Capacitor) + android-tv (Capacitor)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "desktop:dev": "npm --prefix apps/desktop run electron:dev",
    "desktop:selftest": "npm --prefix apps/desktop run selftest",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:build:mac": "npm --prefix apps/desktop run electron:build:mac",
    "desktop:build:win": "npm --prefix apps/desktop run electron:build:win",
    "desktop:pack": "npm --prefix apps/desktop run pack",
    "fetch:torrserver": "node apps/desktop/scripts/fetch-torrserver.js"
  }
}
