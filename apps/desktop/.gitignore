# ══════════════════════════════════════════════════════════════
# Luminary Desktop — apps/desktop/.gitignore
# ══════════════════════════════════════════════════════════════

# ── Dependencies ──
node_modules/
.pnpm-store/

# ── Build outputs ──
dist/
dist-electron/
release/
out/
*.asar
*.blockmap

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment / Secrets ──
.env
.env.local
.env.*.local
*.local
*.pem

# ── Editor / OS ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── TorrServer binaries (скачиваются scripts/fetch-torrserver.js) ──
resources/torrserver/TorrServer-*

# ── Release artifacts (собираются локально/CI) ──
*.dmg
*.exe
*.zip

# ── Runtime data (TorrServer/JacRed cache — создаются при запуске) ──
Data/

# ── Electron unpacked (временные сборки) ──
*-unpacked/

# ── Helper scripts (local only) ──
verify-zip.ps1
make-mac-zip.ps1
