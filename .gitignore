# ══════════════════════════════════════════════════════════════
# Luminary — Монорепо: корневой .gitignore
# ══════════════════════════════════════════════════════════════

# ── macOS ──
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ── Windows ──
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ──
*~
.directory

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# ── Environment / Secrets ──
.env
.env.local
.env.*.local
*.pem
*.p12
*.pfx
*.jks

# ── ZCode session (не часть проекта) ──
.zcode/

# ── Android / Capacitor (будущий apps/android) ──
apps/android/android/.gradle/
apps/android/android/local.properties
apps/android/node_modules/
*.apk
*.aab

# ── TorrServer binaries (скачиваются CI) ──
**/assets/torrserver/TorrServer-*
**/jniLibs/*/libtorrserver.so

# ── Android signing keystore (генерируется автоматически) ──
**/release-key.jks

# ── Build artifacts (root level) ──
*.tgz
coverage/
